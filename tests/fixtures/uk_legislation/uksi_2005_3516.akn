<akomaNtoso xmlns:uk="https://www.legislation.gov.uk/namespaces/UK-AKN" xmlns:ukl="http://www.legislation.gov.uk/namespaces/legislation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://docs.oasis-open.org/legaldocml/ns/akn/3.0" xsi:schemaLocation="http://docs.oasis-open.org/legaldocml/ns/akn/3.0 http://docs.oasis-open.org/legaldocml/akn-core/v1.0/cos01/part2-specs/schemas/akomantoso30.xsd"><act name="uksi"><meta><identification source="#"><FRBRWork><FRBRthis value="http://www.legislation.gov.uk/id/uksi/2005/3516"/><FRBRuri value="http://www.legislation.gov.uk/id/uksi/2005/3516"/><FRBRdate date="2005-12-15" name="made"/><FRBRauthor href="http://www.legislation.gov.uk/id/government/uk"/><FRBRcountry value="GB-UKM"/><FRBRsubtype value="order"/><FRBRnumber value="3516"/><FRBRname value="S.I. 2005/3516"/><FRBRprescriptive value="true"/></FRBRWork><FRBRExpression><FRBRthis value="http://www.legislation.gov.uk/uksi/2005/3516/made"/><FRBRuri value="http://www.legislation.gov.uk/uksi/2005/3516/made"/><FRBRdate date="2005-12-15" name="made"/><FRBRauthor href="#"/><FRBRlanguage language="eng"/></FRBRExpression><FRBRManifestation><FRBRthis value="http://www.legislation.gov.uk/uksi/2005/3516/made/data.akn"/><FRBRuri value="http://www.legislation.gov.uk/uksi/2005/3516/made/data.akn"/><FRBRdate date="2026-11-01Z" name="transform"/><FRBRauthor href="http://www.legislation.gov.uk"/><FRBRformat value="application/akn+xml"/></FRBRManifestation></identification><lifecycle source="#"><eventRef refersTo="#made" date="2005-12-15" eId="date-made" source="#"/><eventRef refersTo="#coming-into-force" date="2006-01-16" eId="date-cif-1" source="#"/></lifecycle><analysis source="#"><otherAnalysis source=""/></analysis><references source="#"><TLCEvent eId="made" href="" showAs="Made"/><TLCEvent eId="cif" href="" showAs="ComingIntoForce"/><TLCRole eId="ref-d24e138" href="/ontology/role/uk.Divisional Director Highways Agency" showAs="Divisional Director Highways Agency"/><TLCPerson eId="ref-d24e136" href="/ontology/persons/uk.PeterWallwork" showAs="Peter Wallwork"/></references><proprietary xmlns:ukm="http://www.legislation.gov.uk/namespaces/metadata" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dct="http://purl.org/dc/terms/" source="#"><dc:identifier>http://www.legislation.gov.uk/uksi/2005/3516/made</dc:identifier><dc:title>The A3 Trunk Road (Thursley Junction) (One Way Traffic) Order 2005</dc:title><dc:subject>Roads and highways</dc:subject><dc:subject>Vehicles</dc:subject><dc:subject>Traffic management</dc:subject><dc:publisher>King's Printer of Acts of Parliament</dc:publisher><dc:modified>2011-07-04</dc:modified><dc:subject scheme="SIheading">ROAD TRAFFIC</dc:subject><ukm:SecondaryMetadata><ukm:DocumentClassification><ukm:DocumentCategory Value="secondary"/><ukm:DocumentMainType Value="UnitedKingdomStatutoryInstrument"/><ukm:DocumentStatus Value="final"/><ukm:DocumentMinorType Value="order"/></ukm:DocumentClassification><ukm:Year Value="2005"/><ukm:Number Value="3516"/><ukm:DepartmentCode Value="DfT 1450"/><ukm:Made Date="2005-12-15"/><ukm:ComingIntoForce><ukm:DateTime Date="2006-01-16"/></ukm:ComingIntoForce><ukm:ISBN Value="0110738780"/></ukm:SecondaryMetadata><ukm:Alternatives><ukm:Alternative Date="2008-12-09" URI="http://www.legislation.gov.uk/uksi/2005/3516/pdfs/uksi_20053516_en.pdf" Title="Print Version"/></ukm:Alternatives><ukm:Statistics><ukm:TotalParagraphs Value="4"/><ukm:BodyParagraphs Value="4"/><ukm:ScheduleParagraphs Value="0"/><ukm:AttachmentParagraphs Value="0"/><ukm:TotalImages Value="0"/></ukm:Statistics></proprietary></meta><preface eId="preface"><block name="banner">Statutory Instruments</block><block name="number"><docNumber>2005 No. 3516</docNumber></block><container name="subjects"><container name="subject"><block name="subject"><concept refersTo="#">ROAD TRAFFIC</concept></block></container></container><block name="title"><docTitle>The A3 Trunk Road (Thursley Junction) (One Way Traffic) Order 2005</docTitle></block><container name="dates"><block name="madeDate" refersTo="#date-made"><span>Made</span><docDate date="2005-12-15">15th December 2005</docDate></block><block name="commenceDate" refersTo="#date-cif-1"><span>Coming into force</span><docDate date="2006-01-16">16th January 2006</docDate></block></container></preface><preamble><formula name="enactingText"><p>The Secretary of State for Transport, in exercise of the powers conferred by sections 1(1) and 2(1) and (2) of the Road Traffic Regulation Act 1984<authorialNote class="footnote" eId="f00001" marker="1"><p><ref eId="c00001" href="http://www.legislation.gov.uk/id/ukpga/1984/27">1984 c. 27</ref>; sections 1(1) and 2(1) and (2) were amended by the New Roads and Street Works Act <ref eId="c00002" href="http://www.legislation.gov.uk/id/ukpga/1991/22">1991 (c. 22)</ref>, section 168 and Schedule 8, paragraphs 17(2) and 18(2) and (3).</p></authorialNote>, and of all other enabling powers, hereby makes the following Order:</p></formula></preamble><body><article eId="article-1"><num>1.</num><content><p>This Order may be cited as the A3 Trunk Road (Thursley Junction) (One Way Traffic) Order 2005 and shall come into force on 16th January 2006.</p></content></article><article eId="article-2"><num>2.</num><intro><p>In this Order—</p></intro><hcontainer name="definition"><content><p>“the trunk road” means the A3 Trunk Road at Thursley near Hindhead in the Borough of Waverley in the County of Surrey.</p></content></hcontainer><hcontainer name="definition"><content><p>“the slip road” means the slip road which forms a length of Dyehouse Road between the A3 Thursley junction bridge and the northbound carriageway of the trunk road.</p></content></hcontainer></article><article eId="article-3"><num>3.</num><content><p>No person shall cause or permit any vehicle to enter or proceed in any direction other than north easterly on the slip road to the trunk road at the Thursley junction.</p></content></article><article eId="article-4"><num>4.</num><intro><p>The provision of article 3 above shall not apply to—</p></intro><level class="para1" eId="article-4-a"><num>(a)</num><content><p>any vehicle being used for police, ambulance or fire brigade purposes; or</p></content></level><level class="para1" eId="article-4-b"><num>(b)</num><content><p>anything done at the direction of, or with the permission of, a police officer in uniform or a traffic warden.</p></content></level></article><hcontainer name="signatures"><hcontainer name="signatureBlock"><content><p>Signed by authority of the Secretary of State for Transport</p><block name="signature"><signature refersTo="#">Peter Wallwork</signature></block><block name="role"><role refersTo="#">Divisional Director Highways Agency</role></block><block name="organization"><organization refersTo="#">Department for Transport</organization></block><block name="date"><date date="2005-12-15">15th December 2005</date></block></content></hcontainer></hcontainer></body></act></akomaNtoso>