{
  "schema": "aw.chunk-policy.v1",
  "policy_id": "struct-md-768w-o0-adjacent-sections",
  "policy_version": 1,
  "algorithm": "struct-markdown-adjacent-section-pack-v1",
  "epoch": 3,
  "rule_legend": "struct-md-768w-o0-adjacent-sections@3",
  "sizing": {
    "unit": "words",
    "soft_target": 768
  },
  "word_guard": {
    "unit": "words",
    "hard_max": 783,
    "derivation": "soft-target-plus-floor"
  },
  "token_hard_max": {
    "unit": "tokens",
    "exact": 2000,
    "tokenizer_model": "Snowflake/snowflake-arctic-embed-l-v2.0",
    "count_special_tokens": true,
    "split_policy": "line-then-word-exact"
  },
  "overlap": {
    "unit": "words",
    "size": 0,
    "scope": "oversized-unit"
  },
  "merge": {
    "unit": "words",
    "below": 40,
    "policy": "previous-if-fits-else-next"
  },
  "floor": {
    "unit": "words",
    "minimum": 15,
    "per_call_override": true
  },
  "prefix": {
    "unit": "words",
    "maximum": 96,
    "separator": " > ",
    "truncation": "keep-deepest"
  },
  "tail": {
    "under_floor": "merge-into-previous-or-emit",
    "token_split_remainder": "emit-below-floor"
  },
  "section_packing": {
    "unit": "sections",
    "policy": "adjacent-greedy-balanced-tail",
    "headings": "inline-breadcrumb",
    "order": "source-order"
  }
}
